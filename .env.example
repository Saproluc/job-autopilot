# Job AutoPilot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── REQUIRED ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPTIONAL: Job Board Accounts (improves search quality) ────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

INDEED_EMAIL=your@email.com
INDEED_PASSWORD=yourpassword

# ─── OPTIONAL: Notification (get a text when the run finishes) ────────────
# Uses Twilio free tier
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=
